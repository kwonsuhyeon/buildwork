# ============================================================
# buildwork 홈페이지 환경변수 예시
# 사용법: cp .env.local.example .env.local 후 실제 값 입력
# ============================================================

# Notion Integration Secret
# 발급 위치: https://www.notion.so/my-integrations
NOTION_API_KEY=

# AI 인사이트 데이터베이스 ID (32자리 hex)
# Notion DB 페이지 URL에서 확인
NOTION_INSIGHTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 강의자료 데이터베이스 ID
NOTION_RESOURCES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 큐레이션 데이터베이스 ID
NOTION_CURATION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
